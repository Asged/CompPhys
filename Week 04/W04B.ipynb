   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "607a07cd",
   "metadata": {},
   "outputs": [],
   "source": [
    "def potential(x,x0=0,x1=1.5,k=1,A=-1,lambd=.25):\n",
    "    return .5*k*(x-x0)**2 + A*np.exp(-(x-x1)**2 / lambd**2)"
   ]
  },
